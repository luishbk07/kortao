# Production (used when NEXT_PUBLIC_VERCEL_ENV=production)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_SITE_URL=https://kortao.com

# Dev / preview / local (used when NEXT_PUBLIC_VERCEL_ENV is not production)
NEXT_PUBLIC_SUPABASE_URL_DEV=https://your-dev-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY_DEV=your-dev-supabase-anon-key
NEXT_PUBLIC_SITE_URL_DEV=http://localhost:3000

# Server-only: employee emails in /panel/empleados (Auth Admin API).
# Supabase → Project Settings → API → service_role / secret key.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_SERVICE_ROLE_KEY_DEV=your-dev-supabase-service-role-key

NEXT_PUBLIC_SOPORTE_WHATSAPP=18090000000

WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-whatsapp-business-account-id

RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM_EMAIL=Kortao <onboarding@resend.dev>
SOPORTE_ADMIN_EMAIL=soporte@kortao.com
